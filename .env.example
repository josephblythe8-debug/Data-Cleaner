# Mock mode is on by default — the app runs with zero setup and none of
# these variables are required. Set both Supabase variables to switch to
# Phase 2 (real Supabase backend). See README.md for the full walkthrough.

# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Force mock mode on/off explicitly. Defaults to "true" unless the two
# Supabase variables above are both set.
# VITE_MOCK_MODE=true
